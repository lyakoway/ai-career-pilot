# CareerPilot AI backend — пример конфигурации. Скопировать в backend/.env (не коммитится).
# Префикс CP_ обязателен; неизвестные CP_* и невалидные значения — отказ старта (ARCHITECTURE §9).

CP_APP_ENV=local                    # local | production (production запрещает CP_COOKIE_SECURE=false)
CP_LOG_LEVEL=INFO
CP_LOG_FORMAT=console               # console | json

# --- PostgreSQL (runtime — под ограниченной ролью cp_app) ---
CP_DATABASE_URL=postgresql+asyncpg://cp_app:cp_app@localhost:5432/careerpilot
CP_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://cp_migrations:cp_migrations@localhost:5432/careerpilot
CP_DB_APP_ROLE=cp_app

# --- Redis (подключается в S1.4: rate limiting auth; fail-closed) ---
CP_REDIS_URL=redis://localhost:6379/0
CP_RATELIMIT_HMAC_KEY=change-me-random-min-32-bytes-secret-value

# --- Auth (S1.3/S1.4) ---
CP_JWT_SECRET=change-me-min-32-bytes-random-secret-value
CP_ACCESS_TTL_SECONDS=900
CP_REFRESH_TTL_DAYS=30
CP_ALLOW_REGISTRATION=false
CP_ALLOWED_ORIGIN=http://localhost:5173
CP_COOKIE_SECURE=false              # только для local

# --- Rate limits (гипотезы; STAGE_1_PLAN §9.3) ---
CP_RATE_LIMIT_AUTH_PER_MINUTE_IP=30
CP_RATE_LIMIT_LOGIN_PER_MINUTE_IP=10
CP_RATE_LIMIT_LOGIN_FAILURES_PER_ACCOUNT=10
CP_RATE_LIMIT_LOGIN_FAILURES_WINDOW_SECONDS=900
